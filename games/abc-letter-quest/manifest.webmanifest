{
  "name": "ABC Letter Quest",
  "short_name": "ABC Letters",
  "description": "Big colourful ABC letter recognition and sound trainer with real pictures. Order, random, backwards, and song.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#FFF8F0",
